        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"LEDGER-001\",\n  \"name\": \"Data Structures\",\n  \"credits\": 4,\n  \"internal\": 32,\n  \"external\": 45,\n  \"attendance\": 88\n}"
