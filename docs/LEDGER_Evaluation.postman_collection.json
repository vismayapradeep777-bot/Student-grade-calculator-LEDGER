{
  "info": {
    "name": "LEDGER Evaluation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health / API manifest",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/api",
        "header": []
      }
    },
    {
      "name": "Register student (Local JSON)",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/json/students",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Student\",\n  \"email\": \"demo@example.com\",\n  \"studentId\": \"LEDGER-001\",\n  \"password\": \"demo123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "http://localhost:5000/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"demo123\"\n}"
        }
      }
    },
    {
      "name": "Get local JSON students",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/api/json/students",
        "header": []
